set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{XT4_ARM_TOOLCHAIN_ROOT})
  message(FATAL_ERROR "Set XT4_ARM_TOOLCHAIN_ROOT to the verified Arm GNU Toolchain root")
endif()
file(TO_CMAKE_PATH "$ENV{XT4_ARM_TOOLCHAIN_ROOT}" ARM_ROOT)
set(CMAKE_C_COMPILER "${ARM_ROOT}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${ARM_ROOT}/bin/arm-none-eabi-g++")
set(CMAKE_ASM_COMPILER "${ARM_ROOT}/bin/arm-none-eabi-gcc")
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -marm -mfloat-abi=soft")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -marm -mfloat-abi=soft")
set(CMAKE_ASM_FLAGS_INIT "-march=armv7-a -marm -mfloat-abi=soft")
